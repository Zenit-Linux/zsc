import Workspace.lexer;
import Workspace.parser;
import Workspace.zbc;
import Workspace.sema;
import Workspace.cli;
import pipeline;

func usage(): void {
    println("użycie:");
    println("  zsc check [--strict] <plik.zs>      składnia + analiza semantyczna (--strict: ostrzeżenia = błąd)");
    println("  zsc build <plik.zs> [-o <plik.zbc>] [--emit zbc]   (domyślnie: pakiet .zbc uruchamiany przez zsi)\n  zsc build ... --target <triple> [-O0..-O3|-Os]   (LLVM: jeszcze niedostępne)");
    println("  zsc analyze <plik.zs>               analiza ucieczki: klasy pamięci ZAMM dla alokacji");
    println("  zsc --tokens <plik.zs>              zrzut tokenów");
    println("  zsc stages                          stan etapów kompilatora");
}

func check(string $file, bool $strict = false): int {
    if (!File.exists($file)) { eprintln("zsc: nie znaleziono pliku " . $file); return 1; }
    # frontend stage1: lekser, parser i analiza semantyczna napisane w Z#
    try { $ast = parser.parse(File.read($file)); }
    catch (Exception $e) { eprintln($file . ": " . $e->getMessage()); return 1; }
    $r = sema.analyze($ast);
    foreach ($r["warnings"] as $w) { eprintln($file . ":" . $w[0] . ": ostrzeżenie: " . $w[1]); }
    if ($strict && count($r["warnings"]) > 0) { return 1; }
    return 0;
}

func analyze(string $file): int {
    if (!File.exists($file)) { eprintln("zsc: nie znaleziono pliku " . $file); return 1; }
    try { $ast = parser.parse(File.read($file)); }
    catch (Exception $e) { eprintln($file . ": " . $e->getMessage()); return 1; }
    println(sema.report(sema.analyze($ast)));
    return 0;
}

func build(string $file, $opts): int {
    if (check($file) !== 0) { return 1; }
    $emit = $opts["options"]["emit"] ?? "zbc";
    $target = $opts["options"]["target"] ?? "host";
    if ($emit !== "zbc" || $target !== "host") {
        eprintln("zsc: backend natywny (LLVM, cel: " . $target . ", emit: " . $emit . ") nie jest jeszcze zaimplementowany — zob. `zsc stages`");
        eprintln("zsc: dostępne: --emit zbc (domyślnie), uruchamiane przez `zsi`");
        return 3;
    }
    $out = $opts["options"]["o"] ?? ($file . ".zbc");
    try { $data = zbc.bundle($file); }
    catch (Exception $e) { eprintln("zsc: " . $e->getMessage()); return 1; }
    File.write($out, $data);
    println("zsc: " . $out . " (" . strlen($data) . " B)");
    return 0;
}

func main(): int {
    $r = cli.parse(System.args(), ["o", "target", "emit"]);
    $pos = $r["positional"];
    $flags = $r["flags"];
    if (has_key($flags, "--tokens") && count($pos) === 1) {
        foreach (lexer.tokenize(File.read($pos[0])) as $t) { println($t["line"] . ":" . $t["col"] . "\t" . $t["kind"] . "\t" . $t["text"]); }
        return 0;
    }
    if (count($pos) === 0) { usage(); return 2; }
    $cmd = $pos[0];
    if ($cmd === "stages") {
        foreach (pipeline.stages() as $s) { println(pad_right($s["name"], 20) . pad_right($s["status"], 8) . $s["impl"]); }
        return 0;
    }
    if (count($pos) < 2) { usage(); return 2; }
    if ($cmd === "check") { return check($pos[1], has_key($flags, "--strict")); }
    if ($cmd === "analyze") { return analyze($pos[1]); }
    if ($cmd === "build") { return build($pos[1], $r); }
    eprintln("zsc: nieznane polecenie " . $cmd);
    usage();
    return 2;
}

exit(main());
