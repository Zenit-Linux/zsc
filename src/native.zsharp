namespace native;

import Workspace.parser;
import Workspace.sema;
import Workspace.ir;
import Workspace.link;
import Workspace.emit_llvm;
import llvmtool;

##
 * Sterownik natywnego backendu zsc: źródło -> AST -> sema -> IR -> LLVM IR -> opt -> llc -> linker (+ runtime) -> binarka.
##

func basename($p) {
    $i = strlen($p) - 1;
    while ($i >= 0 && substr($p, $i, 1) !== "/") { $i--; }
    return substr($p, $i + 1);
}

func stem($p) {
    $b = basename($p);
    $dot = -1;
    for ($i = 0; $i < strlen($b); $i++) { if (substr($b, $i, 1) === ".") { $dot = $i; } }
    return $dot > 0 ? substr($b, 0, $dot) : $b;
}

##
 * Katalog główny Z-Sharp (runtime/include + target/release/libzs_runtime.a).
 * Kolejność: $ZS_HOME, potem rozwiązanie `Workspace` względem skryptu zsc.
##
func zs_root($scriptDir) {
    $env = System.env("ZS_HOME");
    if ($env !== null && $env !== "") { return $env; }
    $d = $scriptDir;
    if (!starts_with($d, "/")) { $d = (System.env("PWD") ?? ".") . "/" . $d; }
    foreach ([$d . "/../share/z-sharp", $d . "/share/z-sharp"] as $c) {
        if (File.exists($c . "/runtime/native/zs_rt.c")) { return $c; }
    }
    $f = System.resolveImport(["Workspace", "cli"], $scriptDir);
    if ($f === null) { return null; }
    return System.dirname(System.dirname($f));
}

##
 * Frontend wspólny dla wszystkich poleceń. Zwraca ["ast" => ..., "warnings" => ...] albo rzuca Exception
 * z gotowym komunikatem `plik:linia:kolumna: błąd: ...`.
##
func frontend($file, $doLink = false) {
    if (!File.exists($file)) { throw new Exception("zsc: nie znaleziono pliku " . $file); }
    try { $ast = parser.parse(File.read($file)); }
    catch (Exception $e) {
        # komunikaty parsera/lexera zaczynają się od `linia:kolumna:`
        throw new Exception($file . ":" . $e->getMessage());
    }
    $r = sema.analyze($ast);
    if (!$doLink) { return ["ast" => $ast, "warnings" => $r["warnings"]]; }
    $lk = link.link($ast, $file);
    if (count($lk["errors"]) > 0) {
        foreach ($lk["errors"] as $e) { eecho($e[3] . ":" . $e[0] . ": błąd [" . $e[1] . "]: " . $e[2]); }
        throw new Exception("zsc: " . count($lk["errors"]) . " błędów linkowania modułów");
    }
    return ["ast" => $lk["ast"], "warnings" => $r["warnings"]];
}

func print_warnings($file, $warnings) {
    foreach ($warnings as $w) { eecho($file . ":" . $w[0] . ": ostrzeżenie: " . $w[1]); }
}

##
 * Lowering do IR; błędy backendu natywnego wypisuje w formacie `plik:linia: błąd [Exxxx]: ...`.
 * Zwraca IR albo null, jeśli były błędy.
##
func lower_or_report($file, $ast) {
    $res = ir.lower($ast);
    if (count($res["errors"]) === 0) { return $res; }
    foreach ($res["errors"] as $e) { eecho($file . ":" . $e[0] . ": błąd [" . $e[1] . "]: " . $e[2]); }
    eecho("zsc: " . count($res["errors"]) . " błędów — pełny język działa przez `zsc build --emit zbc` (uruchamianie: zsi)");
    return null;
}

func opt_level($opts) {
    foreach (["-O0", "-O1", "-O2", "-O3", "-Os", "-Oz"] as $o) { if (has_key($opts["flags"], $o)) { return $o; } }
    return "-O2";
}

##
 * Toolchain LLVM (wersja >= 21). Zwraca tablicę z detect() albo null (komunikat już wypisany).
##
func toolchain($opts) {
    $tc = llvmtool.detect($opts);
    if (!$tc["ok"]) { eecho($tc["err"]); return null; }
    return $tc;
}

##
 * Etapy backendu: frontend -> IR -> .ll. Zwraca ["ll" => tekst, "triple" => ..., "explicit" => bool] albo null.
##
func make_ll($file, $opts, $tc) {
    try { $fe = frontend($file, true); }
    catch (Exception $e) { eecho($e->getMessage()); return null; }
    print_warnings($file, $fe["warnings"]);
    $irr = lower_or_report($file, $fe["ast"]);
    if ($irr === null) { return null; }
    $target = $opts["options"]["target"] ?? "host";
    $explicit = $target !== "host";
    $triple = $explicit ? $target : llvmtool.host_triple($tc);
    try { $ll = emit_llvm.generate($irr, $triple); }
    catch (Exception $e) { eecho("zsc: błąd wewnętrzny backendu LLVM: " . $e->getMessage()); return null; }
    return ["ll" => $ll, "triple" => $triple, "explicit" => $explicit];
}

##
 * Kompilacja do wskazanego rodzaju wyjścia: ll | bc | asm | obj | exe. Zwraca 0 albo kod błędu.
##
func compile($file, $kind, $out, $opts, $scriptDir) {
    $tc = toolchain($opts);
    if ($tc === null) { return 3; }
    $m = make_ll($file, $opts, $tc);
    if ($m === null) { return 1; }
    if ($kind === "ll") { File.write($out, $m["ll"]); return 0; }
    $level = opt_level($opts);
    $tmp = llvmtool.tmp_dir();
    $keep = has_key($opts["flags"], "--keep-temps");
    $ll = $tmp . "/prog.ll";
    $bc = $tmp . "/prog.bc";
    File.write($ll, $m["ll"]);
    $bcOut = $kind === "bc" ? $out : $bc;
    $r = llvmtool.optimize($tc, $ll, $bcOut, $level, $m["triple"]);
    if (!$r["ok"]) {
        eecho($r["err"]);
        eecho("zsc: błąd wewnętrzny: wygenerowany LLVM IR nie przeszedł opt (zachowano " . $tmp . ")");
        return 1;
    }
    if ($kind === "bc") { if (!$keep) { llvmtool.cleanup($tmp); } return 0; }
    $ft = $kind === "asm" ? "asm" : "obj";
    $o1 = ($kind === "asm" || $kind === "obj") ? $out : $tmp . "/prog.o";
    $r = llvmtool.codegen($tc, $bc, $o1, $level, $m["triple"], $ft, $m["explicit"]);
    if (!$r["ok"]) { eecho($r["err"]); return 1; }
    if ($kind === "asm" || $kind === "obj") {
        if (!$keep) { llvmtool.cleanup($tmp); }
        return 0;
    }
    $root = zs_root($scriptDir);
    if ($root === null) { eecho("zsc: nie znaleziono Z-Sharp — ustaw ZS_HOME"); return 1; }
    $rt = llvmtool.runtime_obj($tc, $root, $m["triple"], $opts, $level);
    if (!$rt["ok"]) { eecho($rt["err"]); return 1; }
    $r = llvmtool.link($tc, [$o1, $rt["path"]], $out, $m["triple"], $m["explicit"], $opts);
    if (!$r["ok"]) { eecho($r["err"]); return 1; }
    if (!$keep) { llvmtool.cleanup($tmp); }
    return 0;
}

func build_exe($file, $out, $opts, $scriptDir) {
    return compile($file, "exe", $out, $opts, $scriptDir);
}
