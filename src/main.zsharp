import Workspace.lexer;
import Workspace.parser;
import Workspace.zbc;
import Workspace.sema;
import Workspace.ir;
import Workspace.cli;
import pipeline;
import native;
import Workspace.emit_c;
import Workspace.emit_llvm;

func usage(): void {
    echo "zsc — kompilator Z# 0.0.1";
    echo "użycie:";
    echo "  zsc build <plik.zs> [-o <wyjście>] [--emit exe|c|ll|ir|zbc] [--backend c|llvm] [-O0..-O3|-Os] [--cc <cc>] [--keep-c]";
    echo "      domyślnie: binarka natywna (backend C + cc + runtime/native/zs_rt.c); --backend llvm: LLVM IR + clang; --emit ll: tylko .ll";
    echo "  zsc run <plik.zs> [-- argumenty...]   zbuduj i uruchom";
    echo "  zsc check [--strict] [--native] <plik.zs>   składnia + sema (--native: zgodność z backendem natywnym)";
    echo "  zsc analyze <plik.zs>                analiza ucieczki: klasy pamięci ZAMM dla alokacji";
    echo "  zsc --tokens <plik.zs>               zrzut tokenów";
    echo "  zsc stages                           stan etapów kompilatora";
    echo "  zsc --version | --help";
    echo "kody wyjścia: 0 ok, 1 błąd, 2 użycie, 3 funkcja niedostępna";
    echo "zmienne: ZS_HOME (katalog Z-Sharp), ZS_RUNTIME_LIB, ZS_CC";
}

func check(string $file, bool $strict = false, bool $nativeMode = false): int {
    try { $fe = native.frontend($file, $nativeMode); }
    catch (Exception $e) { eecho($e->getMessage()); return 1; }
    native.print_warnings($file, $fe["warnings"]);
    if ($strict && count($fe["warnings"]) > 0) { return 1; }
    if ($nativeMode && native.lower_or_report($file, $fe["ast"]) === null) { return 1; }
    return 0;
}

func analyze(string $file): int {
    try { $fe = native.frontend($file); }
    catch (Exception $e) { eecho($e->getMessage()); return 1; }
    echo sema.report(sema.analyze($fe["ast"]));
    return 0;
}

func build_zbc(string $file, string $out): int {
    if (check($file) !== 0) { return 1; }
    try { $data = zbc.bundle($file); }
    catch (Exception $e) { eecho("zsc: " . $e->getMessage()); return 1; }
    File.write($out, $data);
    echo "zsc: " . $out . " (" . strlen($data) . " B)";
    return 0;
}

func build(string $file, $opts, $scriptDir): int {
    $o = $opts["options"];
    $emit = $o["emit"] ?? "exe";
    $target = $o["target"] ?? "host";
    if ($target !== "host" && ($o["backend"] ?? "c") !== "llvm") {
        eecho("zsc: --target " . $target . " wymaga --backend llvm (backend C: użyj --cc <cross-gcc>)");
        return 3;
    }
    if (!in_array($emit, ["exe", "c", "ll", "ir", "zbc"])) { eecho("zsc: nieznany --emit " . $emit . " (exe|c|ll|ir|zbc)"); return 2; }
    $bk = $o["backend"] ?? "c";
    if (!in_array($bk, ["c", "llvm"])) { eecho("zsc: nieznany --backend " . $bk . " (c|llvm)"); return 2; }
    $stem = native.stem($file);
    if ($emit === "zbc") { return build_zbc($file, $o["o"] ?? ($stem . ".zbc")); }
    if ($emit === "ir") {
        try { $fe = native.frontend($file, true); }
        catch (Exception $e) { eecho($e->getMessage()); return 1; }
        $res = ir.lower($fe["ast"]);
        echo ir.report($res);
        foreach ($res["errors"] as $e) { eecho($file . ":" . $e[0] . ": błąd [" . $e[1] . "]: " . $e[2]); }
        return count($res["errors"]) > 0 ? 1 : 0;
    }
    $out = $o["o"] ?? $stem;
    if ($emit === "c") {
        try { $fe = native.frontend($file, true); }
        catch (Exception $e) { eecho($e->getMessage()); return 1; }
        $res = native.lower_or_report($file, $fe["ast"]);
        if ($res === null) { return 1; }
        $cpath = has_key($o, "o") ? $out : $stem . ".c";
        File.write($cpath, emit_c.generate($res));
        echo "zsc: " . $cpath;
        return 0;
    }
    if ($emit === "ll") {
        try { $fe = native.frontend($file, true); }
        catch (Exception $e) { eecho($e->getMessage()); return 1; }
        $res = native.lower_or_report($file, $fe["ast"]);
        if ($res === null) { return 1; }
        $lpath = has_key($o, "o") ? $out : $stem . ".ll";
        File.write($lpath, emit_llvm.generate($res, $target === "host" ? "x86_64-pc-linux-gnu" : $target));
        echo "zsc: " . $lpath;
        return 0;
    }
    $rc = native.build_exe($file, $out, $opts, $scriptDir, has_key($opts["flags"], "--keep-c"));
    if ($rc === 0) { echo "zsc: " . $out; }
    return $rc;
}

func run(string $file, $opts, $extra, $scriptDir): int {
    $dir = System.env("TMPDIR") ?? "/tmp";
    $tmp = $dir . "/zsc-run-" . intval(System.time() * 1000);
    Directory.create($tmp);
    $exe = $tmp . "/" . native.stem($file);
    $rc = native.build_exe($file, $exe, $opts, $scriptDir, false);
    if ($rc !== 0) { return $rc; }
    $status = Process.exec($exe, $extra);
    File.delete($exe);
    return $status;
}

func main(): int {
    $argv = System.args();
    $scriptDir = System.dirname($argv[0]);
    $r = cli.parse($argv, ["o", "target", "emit", "cc", "backend"]);
    $pos = $r["positional"];
    $flags = $r["flags"];
    if (has_key($flags, "--version")) { echo "zsc " . System.version; return 0; }
    if (has_key($flags, "--help") || has_key($flags, "-h")) { usage(); return 0; }
    if (has_key($flags, "--tokens") && count($pos) === 1) {
        foreach (lexer.tokenize(File.read($pos[0])) as $t) { echo $t["line"] . ":" . $t["col"] . "\t" . $t["kind"] . "\t" . $t["text"]; }
        return 0;
    }
    if (count($pos) === 0) { usage(); return 2; }
    $cmd = $pos[0];
    if ($cmd === "stages") {
        foreach (pipeline.stages() as $s) { echo pad_right($s["name"], 20) . pad_right($s["status"], 8) . $s["impl"]; }
        return 0;
    }
    if (count($pos) < 2) { usage(); return 2; }
    if ($cmd === "check") { return check($pos[1], has_key($flags, "--strict"), has_key($flags, "--native")); }
    if ($cmd === "analyze") { return analyze($pos[1]); }
    if ($cmd === "build") { return build($pos[1], $r, $scriptDir); }
    if ($cmd === "run") { return run($pos[1], $r, array_slice($pos, 2, count($pos) - 2), $scriptDir); }
    eecho("zsc: nieznane polecenie " . $cmd);
    usage();
    return 2;
}

exit(main());
